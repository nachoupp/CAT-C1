{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/ia.js": {
      "maxDuration": 60
    },
    "api/tts.js": {
      "maxDuration": 60
    },
    "api/stt.js": {
      "maxDuration": 60
    },
    "api/probe.js": {
      "maxDuration": 60
    }
  }
}
